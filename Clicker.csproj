<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>DamnClick</AssemblyName>
    <RootNamespace>Clicker</RootNamespace>
    <Version>1.0.0</Version>
    <Description>DamnClick - profiles clicker for VimeWorld</Description>
    <Company>DamnClick</Company>
    <Product>DamnClick</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="snd_on.wav" />
    <Resource Include="snd_off.wav" />
  </ItemGroup>

</Project>

<Window x:Class="Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DamnClick" Height="600" Width="400"
        MinHeight="480" MinWidth="340"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ PROFILES VIEW ============ -->
        <DockPanel x:Name="ProfilesView" Grid.Row="0" Margin="14">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                <TextBlock Text="DamnClick" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                           DockPanel.Dock="Left" Foreground="{DynamicResource AccentBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="InfoBtn" Content="ⓘ" Style="{StaticResource HeaderIconButton}"
                            Click="InfoBtn_Click" Margin="0,0,6,0"/>
                    <Button x:Name="SettingsBtn" Content="⚙" Style="{StaticResource HeaderIconButton}"
                            Click="SettingsBtn_Click" ToolTip="Settings"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="ProfilesTitle" Text="Profiles" Foreground="{StaticResource DimBrush}"
                       FontSize="12" DockPanel.Dock="Top" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="AddProfileBtn" Content="Новый профиль" Click="AddProfileBtn_Click"
                        Style="{StaticResource AccentButton}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RenameProfileBtn" Grid.Column="0" Content="Rename"
                            Click="RenameProfileBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="ImportBtn" Grid.Column="1" Content="↓🗎" FontSize="14" Width="60"
                            Click="ImportBtn_Click" Margin="4,0,0,0"/>
                </Grid>
            </StackPanel>
            <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                <Button x:Name="EnterProfileBtn" Grid.Column="1" Content="➤"
                                        Style="{StaticResource RowIconButton}"
                                        Margin="6,0,0,0" Click="EnterProfileBtn_Click" Loaded="RowBtn_Loaded"/>
                                <Button x:Name="ExportRowBtn" Grid.Column="2" Content="🗎↑"
                                        Style="{StaticResource RowIconButton}" FontSize="12"
                                        Margin="4,0,0,0" Click="ExportRowBtn_Click" Loaded="RowBtn_Loaded"/>
                                <Button x:Name="DeleteRowBtn" Grid.Column="3" Content="🗑"
                                        Style="{StaticResource RowDangerButton}"
                                        Margin="4,0,0,0" Click="DeleteRowBtn_Click" Loaded="RowBtn_Loaded"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ============ BLOCKS VIEW ============ -->
        <DockPanel x:Name="BlocksView" Grid.Row="0" Margin="14" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                <Button x:Name="BackBtn" Content="←" Style="{StaticResource HeaderIconButton}"
                        Click="BackBtn_Click" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="CurrentProfileTitle" Text="Default" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
            <Button x:Name="AddBlockBtn" Content="Добавить" DockPanel.Dock="Bottom"
                    Click="AddBlockBtn_Click" Style="{StaticResource AccentButton}" Margin="0,10,0,0"/>
            <TextBlock x:Name="CaptureHint" DockPanel.Dock="Top" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"
                       Visibility="Collapsed" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BlocksPanel"/>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ SETTINGS VIEW ============ -->
        <DockPanel x:Name="SettingsView" Grid.Row="0" Margin="14" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                <Button x:Name="SettingsBackBtn" Content="←" Style="{StaticResource HeaderIconButton}"
                        Click="SettingsBackBtn_Click" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
            <StackPanel>
                <Label x:Name="LangLabel" Content="Language"/>
                <ComboBox x:Name="LangBox" Margin="0,0,0,14" SelectionChanged="LangBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="Русский" Tag="ru"/>
                </ComboBox>
                <Label x:Name="AccentLabel" Content="Accent color"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <StackPanel x:Name="AccentPresets" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Button x:Name="CustomColorBtn" Content="…" Width="30" Height="26" Margin="6,0,0,0"
                            Style="{StaticResource AccentPreset}" Click="CustomColorBtn_Click"/>
                </StackPanel>
                <CheckBox x:Name="TrayOnCloseBox" Margin="0,14,0,0"
                          Checked="TrayOnCloseBox_Changed" Unchecked="TrayOnCloseBox_Changed"/>
                <CheckBox x:Name="ShowStatusBox" Margin="0,10,0,0"
                          Checked="ShowStatusBox_Changed" Unchecked="ShowStatusBox_Changed"/>
                <Label x:Name="SoundVolumeLabel" Content="Sound volume" Margin="0,10,0,0"/>
                <DockPanel Margin="0,0,0,0">
                    <TextBox x:Name="SoundVolumeBox" Width="56" DockPanel.Dock="Right" Margin="8,0,0,0"
                             TextChanged="SoundVolumeBox_TextChanged"/>
                    <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ValueChanged="SoundVolumeSlider_ValueChanged"/>
                </DockPanel>
                <Label x:Name="DataPathLabel" Content="Data folder" Margin="0,10,0,0"/>
                <DockPanel>
                    <Button x:Name="BrowseBtn" Content="…" Width="34" DockPanel.Dock="Right"
                            Margin="6,0,0,0" Click="BrowseBtn_Click"/>
                    <TextBox x:Name="DataPathBox" TextChanged="DataPathBox_TextChanged"/>
                </DockPanel>
            </StackPanel>
        </DockPanel>

        <StatusBar x:Name="StatusBar" Grid.Row="1">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="idle" Foreground="{StaticResource DimBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
